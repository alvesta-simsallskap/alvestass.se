---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Startsidan">
  <Hero />
  <section class="section">
    <div class="container is-max-desktop">
      <div class="columns is-multiline">
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h2 class="title is-4">Simskola</h2>
              <p class="block">Lär dig simma med vår simskola — grupper för alla åldrar och nivåer.</p>
            </div>
            <div class="card-footer">
              <a href="/simskola" class="card-footer-item">Läs mer →</a>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h2 class="title is-4">Träningsgrupper</h2>
              <p class="block">Träna och tävla med oss — grupper för alla nivåer från nybörjare till elit.</p>
            </div>
            <div class="card-footer">
              <a href="/traning" class="card-footer-item">Läs mer →</a>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h2 class="title is-4">Om föreningen</h2>
              <p class="block">Lär känna Alvesta Simsällskap — grundat 1921 med simning i fokus.</p>
            </div>
            <div class="card-footer">
              <a href="/foreningen" class="card-footer-item">Läs mer →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
