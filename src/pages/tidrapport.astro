---
export const prerender = false;
// SSR required: schedule and config are fetched from Trailbase at request time (FR-001, FR-002)

import 'bulma/css/bulma.min.css';
import '../styles/_global.scss';

import { env } from 'cloudflare:workers';
import TimeReportCheckboxGroup from '../components/TimeReportCheckboxGroup.astro';
import { authenticateServiceUser, fetchTimeReportConfig, fetchTimeReportSessions } from '../lib/trailbase';
import type { TrainingGroupKey, TimeReportConfig } from '../lib/types';

type CheckboxItem = { date: string; title: string; h: number; m: number };

let error = false;
let config: TimeReportConfig | null = null;
let mappedSessions: Record<TrainingGroupKey, CheckboxItem[]> = {
  simskola: [], tavlingA: [], tavlingB: [], teknik: [], masters: [], vuxencrawl: [],
};

try {
  const authToken = await authenticateServiceUser(env.TRAILBASE_URL, env.TRAILBASE_SERVICE_EMAIL, env.TRAILBASE_SERVICE_PASSWORD);
  config = await fetchTimeReportConfig(env.TRAILBASE_URL, authToken);
  if (!config) throw new Error('No config row found in time_report_config');

  const sessions = await fetchTimeReportSessions(env.TRAILBASE_URL, config.active_month_key, authToken);
  for (const session of sessions) {
    const group = session.training_group as TrainingGroupKey;
    if (group in mappedSessions) {
      mappedSessions[group].push({ date: session.date, title: session.title, h: session.hours, m: session.minutes });
    }
  }
} catch (err) {
  console.error('[tidrapport] Trailbase fetch failed:', err instanceof Error ? err.message : String(err));
  error = true;
}

Astro.response.headers.set('Cache-Control', 'no-store');
---

<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tidrapport {config?.active_month_display ?? ''}</title>
  </head>
  <body>
    <section class="section">
      <div class="container is-max-desktop">
        <h1 class="title">Alvesta Simsällskap</h1>
        <h2 class="subtitle">Tidrapport {config?.active_month_display ?? ''}</h2>

        {error && (
          <div class="notification is-danger">
            Det gick inte att hämta schemat just nu. Försök igen om en stund.
          </div>
        )}

        {!error && (
        <div x-data="{
          step: 1,
          email: '',
          loading: false,
          error: null,
          role: null,
          extraTimes: [{ id: Date.now(), date: '', h: 0, m: 0, desc: '' }],
          ovrigTidOpen: false,
          ovrigTidError: null,
          files: [{ id: Date.now(), file: null, desc: '' }],
          previewHtml: '',
          previewLoading: false,

          async lookupEmail() {
            this.loading = true;
            this.error = null;
            try {
              const res = await fetch('/api/lookup-instructor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: this.email }),
              });
              if (res.status === 404) {
                this.error = 'Din e-postadress hittades inte. Kontrollera att du angav rätt adress.';
              } else if (!res.ok) {
                this.error = 'Det gick inte att kontrollera e-postadressen just nu. Försök igen om en stund.';
              } else {
                this.role = await res.json();
                this.step = 2;
              }
            } catch {
              this.error = 'Det gick inte att kontrollera e-postadressen just nu. Försök igen om en stund.';
            } finally {
              this.loading = false;
            }
          },

          collectExtraTime(formData) {
            this.extraTimes.forEach((item, idx) => {
              formData.append('extratid[' + idx + '][date]', item.date);
              formData.append('extratid[' + idx + '][h]', item.h);
              formData.append('extratid[' + idx + '][m]', item.m);
              formData.append('extratid[' + idx + '][desc]', item.desc);
            });
          },

          async showPreview() {
            this.ovrigTidError = null;
            const touchedRows = this.extraTimes.filter(item =>
              item.date || String(item.desc).trim() || Number(item.h) > 0 || Number(item.m) > 0
            );
            const invalidRows = touchedRows.filter(item =>
              !String(item.desc).trim() || (Number(item.h) === 0 && Number(item.m) === 0)
            );
            if (invalidRows.length > 0) {
              this.ovrigTidError = 'Varje rad i Övrig tid måste ha en beskrivning och tid angiven.';
              this.ovrigTidOpen = true;
              return;
            }
            this.previewLoading = true;
            const formData = new FormData(this.$refs.form);
            this.collectExtraTime(formData);
            try {
              const res = await fetch('/api/preview-time-report', { method: 'POST', body: formData });
              if (res.ok) {
                this.previewHtml = await res.text();
                this.step = 3;
              } else {
                alert('Det gick inte att förhandsgranska tidrapport. Försök igen.');
              }
            } catch {
              alert('Det gick inte att förhandsgranska tidrapport. Försök igen.');
            } finally {
              this.previewLoading = false;
            }
          },

          async handleSubmit() {
            const formData = new FormData(this.$refs.form);
            this.collectExtraTime(formData);
            const res = await fetch('/api/send-time-report', { method: 'POST', body: formData });
            if (res.ok) {
              window.location.href = '/tack';
            } else {
              alert('Något gick fel. Försök igen.');
            }
          }
        }">

          <!-- Step 1: Email identification -->
          <div x-show="step === 1">
            <div class="box mt-5">
              <div class="field">
                <label class="label">E-postadress</label>
                <div class="control">
                  <input
                    class="input"
                    type="email"
                    placeholder="din@epost.se"
                    x-model="email"
                    autocomplete="email"
                    required
                    @keydown.enter.prevent="if (email) lookupEmail()"
                  />
                </div>
                <p class="help">Ange din registrerade e-postadress för att fortsätta.</p>
              </div>
              <div x-show="error" class="notification is-danger mt-3 py-2 px-4" x-text="error"></div>
              <div class="field mt-4">
                <div class="control">
                  <button
                    class="button is-link is-primary"
                    type="button"
                    :disabled="loading || !email"
                    @click="lookupEmail()"
                    x-text="loading ? 'Söker...' : 'Fortsätt'"
                  ></button>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 2: Role-specific time report form -->
          <div x-show="step === 2">
            <form x-ref="form" @timereportupdate.window="void 0">

              <input type="hidden" name="email" :value="email" />

              <div class="box mt-5">
                <div class="field">
                  <label class="label">Namn</label>
                  <div class="control">
                    <input class="input" type="text" placeholder="Namn" name="namn" required autocomplete="name" />
                  </div>
                </div>
              </div>

              <!-- Simskola — only for swim school instructors (swim_school_rate set) -->
              <template x-if="role?.swimSchool">
                <div class="box mt-5" x-data="{ open: false }">
                  <h2 class="subtitle my-0" @click="open = !open" style="cursor:pointer;">
                    Simskola
                    <span x-text="open ? '▲' : '▼'" class="ml-2 is-size-6"></span>
                  </h2>
                  <div class="mt-4" x-show="open" x-transition>
                    <TimeReportCheckboxGroup section="simskola" items={mappedSessions.simskola} />
                    <p class="has-text-grey"><i>30 minuter för förberedelse och undanplockning läggs automatiskt till på varje simskoletillfälle.</i></p>
                  </div>
                </div>
              </template>

              <!-- Träningsgrupper — only for coaches (coach_rate set) -->
              <template x-if="role?.coach">
                <div class="box mt-5" x-data="{ open: false }">
                  <h2 class="subtitle my-0" @click="open = !open" style="cursor:pointer;">
                    Träningsgrupper
                    <span x-text="open ? '▲' : '▼'" class="ml-2 is-size-6"></span>
                  </h2>
                  <div x-show="open" x-transition>
                    <div class="columns mt-2">
                      <div class="column">
                        <TimeReportCheckboxGroup section="tavling-a" items={mappedSessions.tavlingA} label="Tävling A" />
                      </div>
                      <div class="column">
                        <TimeReportCheckboxGroup section="tavling-b" items={mappedSessions.tavlingB} label="Tävling B" />
                      </div>
                      <div class="column">
                        <TimeReportCheckboxGroup section="teknik" items={mappedSessions.teknik} label="Teknik" />
                      </div>
                      <div class="column">
                        <TimeReportCheckboxGroup section="masters" items={mappedSessions.masters} label="Masters" />
                      </div>
                      <div class="column">
                        <TimeReportCheckboxGroup section="vuxencrawl" items={mappedSessions.vuxencrawl} label="Vuxencrawl" />
                      </div>
                    </div>
                    <p class="has-text-grey"><i>15 minuter för förberedelse och undanplockning läggs automatiskt till på varje träning.</i></p>
                  </div>
                </div>
              </template>

              <!-- Övrig tid — always visible -->
              <div class="box mt-5">
                <h2 class="subtitle my-0" @click="ovrigTidOpen = !ovrigTidOpen" style="cursor:pointer;">
                  Övrig tid
                  <span x-text="ovrigTidOpen ? '▲' : '▼'" class="ml-2 is-size-6"></span>
                </h2>
                <div class="mt-4" x-show="ovrigTidOpen" x-transition>
                  <div x-show="ovrigTidError" class="notification is-danger py-2 px-4 mb-3" x-text="ovrigTidError"></div>
                  <template x-for="(item, idx) in extraTimes" :key="item.id">
                    <div class="box mb-3">
                      <div class="field is-horizontal is-align-items-center">
                        <div class="field-body">
                          <div class="field has-addons">
                            <div class="control">
                              <input type="date" class="input" :name="`extratid_date_${item.id}`" x-model="item.date" />
                            </div>
                            <div class="control">
                              <input type="number" class="input" min="0" max="24" :name="`extratid_h_${item.id}`" x-model="item.h" style="max-width: 80px;" />
                            </div>
                            <p class="control"><a class="button is-static">h</a></p>
                            <div class="control">
                              <input type="number" class="input" min="0" max="59" :name="`extratid_m_${item.id}`" x-model="item.m" style="max-width: 80px;" />
                            </div>
                            <p class="control"><a class="button is-static">m</a></p>
                            <div class="control is-expanded">
                              <input type="text" class="input" :name="`extratid_desc_${item.id}`" x-model="item.desc" placeholder="Kort beskrivning" />
                            </div>
                            <p class="control">
                              <a class="button is-danger" type="button" @click="extraTimes.splice(idx, 1)" x-show="extraTimes.length > 1">x</a>
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </template>
                  <button class="button is-link is-light" type="button" @click="extraTimes.push({ id: Date.now() + Math.random(), date: '', h: 0, m: 0, desc: '' })">Lägg till rad</button>
                </div>
              </div>

              <!-- Utlägg — only for coaches (coach_rate set) -->
              <template x-if="role?.coach">
                <div class="box mt-5" x-data="{ open: false }">
                  <h2 class="subtitle my-0" @click="open = !open" style="cursor:pointer;">
                    Utlägg
                    <span x-text="open ? '▲' : '▼'" class="ml-2 is-size-6"></span>
                  </h2>
                  <div class="mt-4" x-show="open" x-transition>
                    <template x-for="(item, idx) in files" :key="item.id">
                      <div class="box mb-3">
                        <div class="field">
                          <label class="label">Fil (pdf, jpg, png)</label>
                          <div class="control">
                            <input type="file" accept=".pdf,.png,.jpg,.jpeg" :name="`utlagg_file_${item.id}`" />
                          </div>
                        </div>
                        <div class="field">
                          <label class="label">Beskrivning</label>
                          <div class="control">
                            <input type="text" class="input" :name="`utlagg_desc_${item.id}`" placeholder="Beskrivning av utlägg" />
                          </div>
                        </div>
                        <button class="button is-small is-danger mt-2" type="button" @click="files.splice(idx, 1)" x-show="files.length > 1">Ta bort</button>
                      </div>
                    </template>
                    <button class="button is-link is-light" type="button" @click="files.push({ id: Date.now() + Math.random(), file: null, desc: '' })">Lägg till fil</button>
                  </div>
                </div>
              </template>

              <!-- Kommentarer + Milersättning — always visible / conditional -->
              <div class="box mt-5">
                <div class="columns">
                  <div class="column">
                    <div class="field">
                      <label class="label">Kommentarer</label>
                      <div class="control">
                        <textarea class="textarea" rows="3" placeholder="Eventuella kommentarer" name="kommentarer"></textarea>
                      </div>
                      <p class="help">Eventuella kommentarer för tillfällena ovan, annan extra arbetstid eller utlägg</p>
                    </div>
                  </div>
                  <!-- Milersättning — only for instructors with travel_compensation = true -->
                  <template x-if="role?.travelCompensation">
                    <div class="column">
                      <div class="field">
                        <label class="label">Milersättning (km)</label>
                        <div class="control">
                          <input class="input" type="number" name="milersattning" min="1" max="1000" placeholder="Ange kilometer" style="max-width: 150px;" />
                        </div>
                        <p class="help">Ange antal kilometer. Till och från träning (2,50 kr/kilometer)</p>
                      </div>
                    </div>
                  </template>
                </div>
              </div>

              {!import.meta.env.DEV ? (
              <div class="field">
                <div class="cf-turnstile" data-sitekey="0x4AAAAAACV0HK5DAZEGpQip" data-theme="light" data-callback="onTurnstileSuccess"></div>
              </div>
              ) : null}
              <div class="field">
                <div class="control">
                  {import.meta.env.DEV ? (
                    <button id="submitBtn" class="button is-link is-primary" type="button" @click="showPreview()" :class="{'is-loading': previewLoading}">Förhandsgranska</button>
                  ) : (
                    <button id="submitBtn" class="button is-link is-primary" type="button" @click="showPreview()" :class="{'is-loading': previewLoading}" disabled>Förhandsgranska</button>
                  )}
                </div>
              </div>

            </form>
          </div>

          <!-- Step 3: Preview and confirm -->
          <div x-show="step === 3">
            <div class="box mt-5">
              <h2 class="title is-5">Granska din tidrapport</h2>
              <p class="mb-4 has-text-grey">Kontrollera att uppgifterna nedan stämmer innan du skickar in.</p>

              <div x-show="previewLoading" class="has-text-centered py-5">
                <span class="button is-loading is-white is-large"></span>
              </div>

              <div x-show="!previewLoading" class="content" x-html="previewHtml"></div>

              <div class="buttons mt-5">
                <button class="button" type="button" @click="step = 2">← Gå tillbaka och korrigera</button>
                <button class="button is-primary" type="button" @click="handleSubmit()">Skicka in tidrapport</button>
              </div>
            </div>
          </div>

        </div>
        )}
      </div>
    </section>
    <script is:inline>
      window.onTurnstileSuccess = function() {
        document.getElementById('submitBtn').disabled = false;
      };
    </script>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </body>
</html>
