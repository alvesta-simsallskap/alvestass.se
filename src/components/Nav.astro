---
const { pathname } = Astro.url;
---

<nav class="navbar is-primary is-fixed-top" role="navigation" aria-label="main navigation" x-bind:class="{ 'scrolled-down': !atTop }">
  <div class="container is-max-desktop">
    <div class="navbar-brand">
      <a class="navbar-item" href="/">
        <img src="/ass-logo.svg" class="logo" />
      </a>
    </div>
    <div class="navbar-menu">
      <div class="navbar-start">
        <a class:list={['navbar-item', { 'is-active': pathname === '/simskola' }]} href="/simskola">Simskola</a>
        <a class:list={['navbar-item', { 'is-active': pathname === '/traning' }]} href="/traning">Grupper</a>
        <a class:list={['navbar-item', { 'is-active': pathname === '/foreningen' }]} href="/foreningen">Föreningen</a>
      </div>
      <div class="navbar-end">
        <div class="navbar-item">
          <a class="navbar-item material-symbols-rounded is-size-3" @click="modal = !modal">account_circle</a>
        </div>
      </div>
    </div>
  </div>
</nav>
